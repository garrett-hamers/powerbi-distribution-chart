# Keep the checked-in submission assets byte-stable across platforms so the
# deterministic audit in scripts/audit-submission-assets.mjs cannot drift.
*.png binary
*.pbiviz binary
*.pbix binary
assets/sample-data/*.csv text eol=crlf
# The sample report project is generated byte-for-byte by scripts/build-sample-report.mjs
# and diffed by the submission audit, so it must not be re-encoded on checkout.
samples/** text eol=lf
samples/**/CustomVisuals/** -text
