{
  "name": "atlyn-distribution",
  "version": "1.0.0",
  "description": "Certification-first grouped distribution box plot for Power BI.",
  "private": true,
  "overrides": {
    "uuid": "11.1.1"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "npm run build",
    "eslint": "eslint .",
    "lint": "eslint .",
    "package": "node scripts/package.mjs",
    "package:certification": "node scripts/package.mjs --certification-audit",
    "package:reproducible": "node scripts/verify-reproducible-package.mjs",
    "release:metadata": "node scripts/release-metadata.mjs",
    "sample-data": "node scripts/write-sample-dataset.mjs",
    "sample-report": "node scripts/build-sample-report.mjs",
    "icon": "node scripts/build-icon.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "audit:submission": "node scripts/audit-submission-assets.mjs",
    "certification-audit": "npm run package:certification && npm run package && npm run audit:submission",
    "start": "pbiviz start",
    "test": "jest --runInBand --coverage",
    "test:watch": "jest --watch",
    "audit": "npm audit --audit-level=high",
    "audit:production": "npm audit --audit-level=high --omit=dev"
  },
  "dependencies": {
    "powerbi-visuals-api": "5.11.1",
    "powerbi-visuals-utils-formattingutils": "6.1.2"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.15.21",
    "@typescript-eslint/eslint-plugin": "8.57.2",
    "@typescript-eslint/parser": "8.57.2",
    "eslint": "9.27.0",
    "eslint-plugin-powerbi-visuals": "1.1.1",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jszip": "3.10.1",
    "jsdom": "26.1.0",
    "powerbi-visuals-tools": "7.2.1",
    "ts-jest": "29.3.2",
    "typescript": "5.8.3"
  }
}
