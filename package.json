{
  "name": "atlyn-distribution",
  "version": "1.0.0",
  "description": "Certification-first grouped distribution box plot for Power BI.",
  "private": true,
  "overrides": {
    "uuid": "11.1.1"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "package": "pbiviz package",
